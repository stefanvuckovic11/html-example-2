<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>See All Products - {{filter}}</title>
    <link rel="stylesheet" href="/css/main.css?v=1548800917231"/>
</head>
<body>

<div class="wrapper" style="display: flex;flex-direction: row;">

<div class="seeAll_left" style="width: 25%">
    {{> indexLeft/accordion}}
    {{> indexLeft/brandPromo}}
    {{> indexLeft/brandSearch}}
    {{> indexLeft/newsletter}}
    {{> indexLeft/productCard
            imgSrc="/images/makita.jpg"
            altText="Makita alat"
            title="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
            description="Etiam dolor tortor, facilisis id ante id, blandit convallis quam. Vivamus tempus."}}
    {{> indexLeft/productCard
            imgSrc="/images/raznecipele.png"
            altText="Radne cipele"
            title="Lorem ipsum dolor sit amet,"
            description="Etiam dolor tortor, facilisis id ante id, blandit convallis quam. Vivamus tempus."}}
    {{> indexLeft/brandPromo}}
</div>
<div class="seeAll_right" style="width: 75%">
    <div class="see-all">
        <h1>All Products: {{filter}}</h1>
        <div class="product-list">
            {{#each products}}
                {{> general/productCard
                        imgSrc=mainImage
                        altText=altText
                        title=title
                        description=description}}
            {{/each}}
        </div>
    </div>
</div>

</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.1.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/handlebars@latest/dist/handlebars.js"></script>
<script src="/js/script-index.js"></script>
<script src="/js/productLoader.js"></script>
</body>
</html>

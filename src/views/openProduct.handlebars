
<div class="product-detail">
    <div class="product-detail__content">
        {{> openProductLeft/productBreadcrumb}}
        <div class="product-detail__body">
            {{> openProductLeft/productGallery}}
            {{> openProductLeft/productInfo}}
            {{> openProductLeft/productAdditional}}
            {{> openProductLeft/productSimilar}}




            <script id="product-card-template" type="text/x-handlebars-template">
                <div class="product-card">
                  <img src="{{mainImage}}" alt="{{title}}" class="product-card__image" />
          <div class="product-card__info">
            <h3 class="product-card__title">{{title}}</h3>
            <p class="product-card__description">{{description}}</p>
            <p class="product-card__price">{{price.new}}</p>
          </div>
        </div>
            </script>
        </div>
    </div>

    <aside class="product-detail__sidebar">
        {{> openProductRight/sidebarVideo1}}
        {{> openProductRight/sidebarVideo2}}
        {{> openProductRight/sidebarNews}}
    </aside>

    <div class="product-detail__modal" id="imageModal">
        <button class="product-detail__modal__close">&times;</button>
        <img class="product-detail__modal__image" id="modalImage" src="" alt="Full Screen Image">
    </div>
</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.1.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/handlebars@latest/dist/handlebars.js"></script>
<script src="/js/script-openProduct.js"></script>

<div class="new-product new-product--hidden">
    <div class="new-product__overlay"></div>
    <div class="new-product__popup">
        <div class="new-product__header">
            <ul class="new-product__tabs">
                <li class="new-product__tab new-product__tab--active" data-tab="create">Kreiraj proizvod</li>
                <li class="new-product__tab" data-tab="update">Ažuriraj proizvod</li>
                <li class="new-product__tab" data-tab="delete">Ukloni proizvod</li>
            </ul>
        </div>
        <div class="new-product__content new-product__content--create">
            <h2 class="new-product__title">Kreiraj proizvod</h2>
            <form class="new-product__form">
                <div class="new-product__form-group">
                    <label class="new-product__label" for="product-title">Naziv proizvoda</label>
                    <input type="text" id="product-title" class="new-product__input" placeholder="Unesite naziv proizvoda">
                </div>
                <div class="new-product__form-group">
                    <label class="new-product__label" for="product-category">Kategorija</label>
                    <input type="text" id="product-category" class="new-product__input" placeholder="Unesite kategoriju">
                </div>
                <div class="new-product__form-group">
                    <label class="new-product__label" for="product-discount">Popust</label>
                    <input type="text" id="product-discount" class="new-product__input" placeholder="Unesite popust">
                </div>
                <div class="new-product__form-group">
                    <label class="new-product__label" for="product-type">Tip</label>
                    <input type="text" id="product-type" class="new-product__input" placeholder="Unesite tip">
                </div>
                <div class="new-product__form-group">
                    <label class="new-product__label" for="product-mainImage">Glavna slika (URL)</label>
                    <input type="text" id="product-mainImage" class="new-product__input" placeholder="URL glavne slike">
                </div>
                <div class="new-product__form-group">
                    <label class="new-product__label" for="product-images">Dodatne slike (odvojene zarezom)</label>
                    <input type="text" id="product-images" class="new-product__input" placeholder="URL-ovi dodatnih slika">
                </div>
                <div class="new-product__form-group">
                    <label class="new-product__label" for="product-description">Opis</label>
                    <textarea id="product-description" class="new-product__input" placeholder="Unesite opis proizvoda"></textarea>
                </div>
                <div class="new-product__form-group">
                    <label class="new-product__label" for="product-timer">Timer</label>
                    <input type="text" id="product-timer" class="new-product__input" placeholder="Unesite timer">
                </div>
                <div class="new-product__form-group">
                    <label class="new-product__label" for="product-price-old">Stara cijena</label>
                    <input type="text" id="product-price-old" class="new-product__input" placeholder="Unesite staru cijenu">
                </div>
                <div class="new-product__form-group">
                    <label class="new-product__label" for="product-price-new">Nova cijena</label>
                    <input type="text" id="product-price-new" class="new-product__input" placeholder="Unesite novu cijenu">
                </div>
                <div class="new-product__form-group">
                    <label class="new-product__label" for="product-brand">Brend</label>
                    <input type="text" id="product-brand" class="new-product__input" placeholder="Unesite brend">
                </div>
                <fieldset class="new-product__fieldset">
                    <legend class="new-product__legend">Specifikacije</legend>
                    <div class="new-product__form-group">
                        <label class="new-product__label" for="product-dimensions">Dimenzije</label>
                        <input type="text" id="product-dimensions" class="new-product__input" placeholder="Unesite dimenzije">
                    </div>
                    <div class="new-product__form-group">
                        <label class="new-product__label" for="product-capacity">Kapacitet</label>
                        <input type="text" id="product-capacity" class="new-product__input" placeholder="Unesite kapacitet">
                    </div>
                    <div class="new-product__form-group">
                        <label class="new-product__label" for="product-energyRating">Energetska klasa</label>
                        <input type="text" id="product-energyRating" class="new-product__input" placeholder="Unesite energetsku klasu">
                    </div>
                    <div class="new-product__form-group">
                        <label class="new-product__label" for="product-features">Funkcije (odvojene zarezom)</label>
                        <input type="text" id="product-features" class="new-product__input" placeholder="Unesite funkcije">
                    </div>
                </fieldset>
                <div class="new-product__form-group">
                    <label class="new-product__label" for="product-relatedProducts">Povezani proizvodi (ID-ovi, odvojeni zarezom)</label>
                    <input type="text" id="product-relatedProducts" class="new-product__input" placeholder="Unesite ID-ove povezanih proizvoda">
                </div>
                <fieldset class="new-product__fieldset">
                    <legend class="new-product__legend">Tabs</legend>
                    <div class="new-product__form-group">
                        <label class="new-product__label" for="product-productionList">Proizvodnja</label>
                        <textarea id="product-productionList" class="new-product__input" placeholder="Unesite informacije o proizvodnji"></textarea>
                    </div>
                    <div class="new-product__form-group">
                        <label class="new-product__label" for="product-guide">Uputstvo</label>
                        <textarea id="product-guide" class="new-product__input" placeholder="Unesite uputstvo"></textarea>
                    </div>
                    <div class="new-product__form-group">
                        <label class="new-product__label" for="product-email">Kontakt Email</label>
                        <input type="email" id="product-email" class="new-product__input" placeholder="Unesite kontakt email">
                    </div>
                </fieldset>
            </form>
        </div>
        <div class="new-product__content new-product__content--update" style="display: none;">
            <h2 class="new-product__title">Ažuriraj proizvod</h2>
            <form class="new-product__form">
                <div class="new-product__form-group">
                    <label class="new-product__label" for="update-product-id">ID proizvoda</label>
                    <input type="text" id="update-product-id" class="new-product__input" placeholder="Unesite ID proizvoda za ažuriranje">
                </div>
                <div class="new-product__form-group">
                    <label class="new-product__label" for="update-product-title">Naziv proizvoda</label>
                    <input type="text" id="update-product-title" class="new-product__input" placeholder="Unesite naziv proizvoda">
                </div>
            </form>
        </div>
        <div class="new-product__content new-product__content--delete" style="display: none;">
            <h2 class="new-product__title">Ukloni proizvod</h2>
            <div class="new-product__delete">
                <label class="new-product__label" for="delete-product-select">Odaberite proizvod za brisanje</label>
                <select id="delete-product-select" class="new-product__input">
                    <option value="">Odaberi proizvod...</option>
                </select>
                <div id="delete-product-card">
                </div>
            </div>
        </div>
        <div class="new-product__form-actions">
            <button type="submit" class="new-product__submit">Spremi</button>
            <button type="button" class="new-product__close">Zatvori</button>
        </div>
    </div>
</div>

<div class="index__right__hotOffer">
    <div class="index__right__hotOffer__header" style="border-bottom-color: rgb(1, 173, 239);">
        <span class="index__right__hotOffer__header-text">
            {{#if product.similarConfig.headerText}}
                {{product.similarConfig.headerText}}
            {{else}}
                Slični proizvodi
            {{/if}}
        </span>
    </div>

    <div class="index__right__hotOffer__product-list" id="similarProductList">
        {{#each product.similarProducts}}
            <a href="openProduct.html?productId={{id}}" class="similar-product-link" style="text-decoration: none; color=black">
            {{> general/productCard
                    imgSrc=mainImage
                    altText=altText
                    title=title
                    description=description
                    id=id
                    discount=discount
                    timer=timer
                    price=price
                    section="hotOffer"
            }}
            </a>
        {{/each}}
    </div>

    <div class="index__right__hotOffer__footer">
        <a href="/src/seeAll.html?type={{product.type}}"
           class="index__right__hotOffer__footer__button"
           style="border-color: {{#if product.similarConfig.buttonBorderColor}}{{product.similarConfig.buttonBorderColor}}{{else}}#ccc{{/if}};">
            {{#if product.similarConfig.footerButtonText}}
                {{product.similarConfig.footerButtonText}}
            {{else}}
                Pogledaj sve
            {{/if}}
        </a>
    </div>
</div>

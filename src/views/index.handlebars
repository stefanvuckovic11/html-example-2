<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Example app</title>
    <!-- app:css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="/css/main.css?v=1548800917231"/>
    <!-- endinject -->
</head>
<body>
<div id="loader" class="loader">
    <div class="loader__spinner"></div>
</div>

<main class="index">
    <div class="index__left">
        {{> indexLeft/accordion}}
        {{> indexLeft/brandPromo}}
        {{> indexLeft/brandSearch}}
        {{> indexLeft/newsletter}}
        {{> indexLeft/productCard
                imgSrc="/images/makita.jpg"
                altText="Makita alat"
                title="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
                description="Etiam dolor tortor, facilisis id ante id, blandit convallis quam. Vivamus tempus."}}
        {{> indexLeft/productCard
                imgSrc="/images/raznecipele.png"
                altText="Radne cipele"
                title="Lorem ipsum dolor sit amet,"
                description="Etiam dolor tortor, facilisis id ante id, blandit convallis quam. Vivamus tempus."}}
        {{> indexLeft/brandPromo}}
    </div>

    <div class="index__right">
        {{> indexRight/slider}}
        {{> indexRight/previewPartial
                section="hot-offer"
                iconClass="index__right__hot-offer__fire-icon fa fa-fire"
                headerText="VRUĆA PONUDA"
                footerButtonText="POGLEDAJTE SVE PROIZVODE IZ VRUĆE PONUDE"}}

        {{> indexRight/previewPartial
                section="action"
                iconClass="index__right__action__action-icon fa fa-tag"
                headerText="AKCIJA - POPUSTI"
                footerButtonText="POGLEDAJTE SVE PROIZVODE IZ AKCIJE"}}

        {{> indexRight/previewPartial
                section="recommended"
                iconClass="index__right__recommended__recommended-icon fa fa-star"
                headerText="PREPORUČUJEMO"
                footerButtonText="POGLEDAJTE SVE PROIZVODE IZ PREPORUČENIH"}}

        {{> indexRight/previewPartial
                section="new"
                iconClass="index__right__new__news-icon fa fa-heart"
                headerText="NOVO U PONUDI"
                footerButtonText="POGLEDAJTE SVE PROIZVODE IZ NOVIH"}}

        {{> indexRight/previewPartial
                section="sale"
                iconClass="index__right__sale__sale-icon fa fa-percent"
                headerText="RASPRODAJA"
                footerButtonText="POGLEDAJTE SVE PROIZVODE IZ RASPRODAJE"}}

        {{> indexRight/brandSearchRight}}
        {{> indexRight/newsletterRight}}
    </div>
</main>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.1.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/handlebars@latest/dist/handlebars.js"></script>
<script src="/js/script-index.js"></script>
<script src="/js/productLoader.js"></script>
</body>
</html>
